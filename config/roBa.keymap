#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <6>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    #define MOUSE 5

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Tomisuke {
            bindings = <
&kp TAB           &kp COMMA     &kp PERIOD    &kp MINUS                    &kp Q                                                        &kp L              &kp R  &kp D  &kp Y  &kp P
&kp A             &kp O         &kp E         &kp I                        &kp U             &none                       &none          &kp G              &kp N  &kp T  &kp S  &kp K
&mt LEFT_SHIFT X  &kp C         &kp V         &kp W                        &mt LEFT_SHIFT F  &kp F13                     &to 7          &mt RIGHT_SHIFT J  &kp H  &kp M  &kp B  &mt RSHIFT Z
&mt LCTRL ESC     &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 LANGUAGE_2  &kp SPACE         &lt_to_layer_0 2 LANG1      &kp BACKSPACE  &lt 3 ENTER                             &lt_to_layer_0 6 DELETE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        Qwerty {
            bindings = <
&kp Q      &kp W     &kp E     &kp R   &kp T                       &kp Y   &kp U  &kp I      &kp O    &kp P
&kp A      &kp S     &kp D     &kp F   &kp G   &trans      &to 0   &kp H   &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X     &kp C     &kp V   &kp B   &none       &none   &kp N   &kp M  &kp COMMA  &kp DOT  &kp FSLH
&kp LCTRL  &kp LALT  &kp LGUI  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        SYMBOLS {
            bindings = <
&kp AMPERSAND  &kp AT          &kp HASH      &kp PERCENT  &trans                      &kp GRAVE         &kp APOS               &kp COLON      &kp SEMI          &trans
&kp TILDE      &kp MINUS       &kp ASTERISK  &kp EQUAL    &trans  &trans      &trans  &kp LEFT_BRACKET  &mt RBKT LEFT_BRACKET  &kp EXCL       &kp QUESTION      &kp PIPE
&kp CARET      &kp UNDERSCORE  &kp DOLLAR    &kp PLUS     &trans  &trans      &trans  &kp LEFT_BRACE    &kp LEFT_PARENTHESIS   &kp LESS_THAN  &kp GREATER_THAN  &trans
&trans         &trans          &trans        &trans       &trans  &trans      &trans  &trans                                                                    &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9     &kp PLUS                                &kp SPACE  &kp SPACE  &kp UP     &kp SPACE  &kp SPACE
&kp SLASH          &kp NUMBER_4  &kp N5        &kp N6           &kp ASTERISK  &trans         &kp SPACE  &kp SPACE  &kp LEFT   &kp DOWN   &kp RIGHT  &kp SPACE
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp PERIOD    &kp EQUAL      &trans     &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE
&trans             &trans        &trans        &kp KP_NUMBER_0  &trans        &trans         &trans     &trans                                      &kp SPACE
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&kp F2           &kp F3  &kp F5  &kp F6   &kp F11                          &kp C_MUTE  &kp K_UNDO     &kp K_REDO        &trans     &kp LS(F2)
&kp LC(LS(TAB))  &trans  &kp F7  &kp F10  &trans   &trans      &kp C_MUTE  &kp C_PP    &kp C_AC_BACK  &kp C_AC_FORWARD  &kp F5     &trans
&kp LC(TAB)      &trans  &trans  &trans   &trans   &trans      &kp LG(L)   &trans      &kp LC(C)      &kp LC(Y)         &kp LC(X)  &trans
&trans           &trans  &trans  &trans   &trans   &trans      &trans      &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        GAME {
            bindings = <
&kp ESCAPE  &kp Q         &kp W         &kp E         &kp R                                 &kp T   &kp Y  &kp U  &kp I      &kp O
&kp TAB     &kp A         &kp S         &kp D         &kp F      &trans             &kp A   &kp G   &kp H  &kp J  &kp K      &kp L
&kp LSHFT   &kp Z         &kp X         &kp C         &kp V      &kp B              &to 8   &kp B   &kp N  &kp M  &kp COMMA  &kp RSHFT
&kp LCTRL   &kp LEFT_WIN  &kp NUMBER_1  &kp LEFT_ALT  &kp SPACE  &kp BACKSPACE      &trans  &trans                           &to 0
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        GAME2 {
            bindings = <
&kp ESC    &trans    &kp UP    &trans     &trans                      &trans  &kp Q           &kp UP_ARROW    &kp E            &trans
&trans     &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp LSHFT  &kp Z     &kp X     &kp C      &trans  &trans      &trans  &trans  &kp Z           &kp X           &kp C            &kp RSHFT
&kp LCTRL  &trans    &trans    &kp Z      &kp X   &kp C       &kp X   &kp Z                                                    &to 0
            >;
        };
    };
};
